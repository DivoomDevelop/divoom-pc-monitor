{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DivoomPCMonitor",
  "version": "1.3.0",
  "identifier": "com.divoom.pcmonitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Divoom PC Monitor",
        "width": 1140,
        "height": 860,
        "minWidth": 980,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/": "monitor/",
      "../../README.md": "README.md",
      "../../README.en.md": "README.en.md",
      "../../docs/VALIDATION.md": "VALIDATION.md",
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "SimpChinese",
          "TradChinese",
          "Japanese",
          "German",
          "Thai",
          "Russian",
          "Korean",
          "Vietnamese",
          "French",
          "Turkish",
          "Spanish",
          "Portuguese",
          "Indonesian",
          "Italian",
          "Ukrainian",
          "Swedish",
          "Danish",
          "Polish"
        ]
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "entitlements": "../../macos/entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
